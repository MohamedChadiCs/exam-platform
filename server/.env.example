NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://exam:exam_dev_password@localhost:5432/exam_platform?schema=public
CLIENT_ORIGIN=http://localhost:5173
TRUST_PROXY=0

# Generate with: npm run keys   (each must be 32 random bytes, base64)
CODE_PEPPER=
CODE_ENC_KEY=
CSRF_SECRET=

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Exam Platform <no-reply@exam.local>"

# Used only by `npm run db:seed` to create the first admin (min 12 chars)
ADMIN_EMAIL=admin@exam.local
ADMIN_PASSWORD=
